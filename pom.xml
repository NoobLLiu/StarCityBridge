<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.starcity</groupId>
    <artifactId>starcity-bridge</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>StarCityBridge</name>
    <description>数据整合插件：统一与 StarCity 网站后端通过 WebSocket 通信</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>fr.xephi.authme</groupId>
            <artifactId>authme</artifactId>
            <version>5.7.0-FORK</version>
            <scope>system</scope>
            <systemPath>D:/java-server/StarCIty/plugins/AuthMe-5.7.0-FORK.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.github.exchange</groupId>
            <artifactId>stockexchange</artifactId>
            <version>1.0.0-gmzc</version>
            <scope>system</scope>
            <systemPath>D:/java-server/dev/local-plugins/stockexchange-patched/build/StockExchange-1.0.0-gmzc.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>cn.gmzc.mgteam</groupId>
            <artifactId>mgteam</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>D:/java-server/dev/local-plugins/MGTeam-JE/build/MGTeam-1.0.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.artformgames.plugin</groupId>
            <artifactId>residencelist-api</artifactId>
            <version>1.4.15</version>
            <scope>system</scope>
            <systemPath>D:/AICode/JAVA-paper/ResidenceList/api/target/residencelist-api-1.4.15.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.bekvon.bukkit</groupId>
            <artifactId>residence</artifactId>
            <version>5.1.3.0</version>
            <scope>system</scope>
            <systemPath>D:/AICode/JAVA-paper/ResidenceList/.lib/Residence5.1.3.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cc.carm.lib</groupId>
            <artifactId>easyplugin-user</artifactId>
            <version>1.5.14</version>
            <scope>system</scope>
            <systemPath>C:/Users/BrianLiu/.m2/repository/cc/carm/lib/easyplugin-user/1.5.14/easyplugin-user-1.5.14.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
